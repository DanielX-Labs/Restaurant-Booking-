PORT=5000
MONGO_URL="Your Mongodb url"
JWT_SECRET="generate-a-random-secret-with-at-least-32-characters"
# Use production on Render. CLIENT_URL accepts comma-separated exact origins.
NODE_ENV=development
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD="choose-a-unique-password-with-at-least-12-characters"

CLOUDINARY_CLOUD_NAME="cloud_name"
CLOUDINARY_API_KEY="cloudinary_api_key"
CLOUDINARY_API_SECRET="cloudinary_api_secret"
BREVO_SENDER_EMAIL="your-verified-sender@example.com"
BREVO_SENDER_NAME="Restaurant"
SUPPORT_EMAIL="support@example.com"
BREVO_EMAIL_TRANSPORT=smtp
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=2525
BREVO_SMTP_LOGIN="your-brevo-smtp-login"
BREVO_SMTP_KEY="your-brevo-smtp-key"
RESTAURANT_NAME=Restaurant
RESTAURANT_ADDRESS=Restaurant address
RESTAURANT_PHONE=Restaurant phone number
RESTAURANT_LOGO=https://your-vercel-domain.vercel.app/logo.png
CURRENCY=NGN
